---
// Carrossel infinito de logos — 5 itens visíveis por vez (largura de cada item = 1/5 do trilho, via container query).
import { Image } from 'astro:assets'
import { brands } from '../data/brands'

/**
 * Menos de 4 logos não faz carrossel: o loop fica visível e a seção parece vazia.
 * Nesse caso o carrossel não renderiza e o cabeçalho da seção que o hospeda ocupa
 * a largura inteira. Cliente sem logos: apague este componente, src/data/brands.ts
 * e src/assets/brands/ (regra 12 do padrão).
 */
const show = brands.length >= 4
---

{show && (
  <div class="brand-carousel relative overflow-hidden">
    <div class="brand-carousel-track flex items-center">
      {/* Lista duplicada para o loop infinito ficar contínuo */}
      {[0, 1].map((copy) => (
        <ul class="flex shrink-0 items-center" aria-hidden={copy === 1 ? 'true' : undefined}>
          {brands.map((brand) => (
            <li class="brand-item flex h-14 shrink-0 items-center justify-center px-4">
              <Image
                src={brand.src}
                alt={brand.name}
                format="webp"
                loading="lazy"
                decoding="async"
                class="h-14 w-auto object-contain"
              />
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
)}

<style>
  .brand-carousel {
    container-type: inline-size;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0,
      black 48px,
      black calc(100% - 48px),
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0,
      black 48px,
      black calc(100% - 48px),
      transparent 100%
    );
  }

  .brand-carousel-track {
    width: max-content;
    animation: brand-scroll 26s linear infinite;
  }

  .brand-item {
    width: calc(100cqw / 5);
  }

  .brand-carousel:hover .brand-carousel-track {
    animation-play-state: paused;
  }

  @keyframes brand-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-carousel-track {
      animation: none;
    }
  }
</style>
