---
/**
 * Header no visual COAIR: faixa translúcida sobre a foto do hero, logo, menu de âncoras e
 * CTA com contorno verde-água. Fica fixo no topo e escurece ao rolar a página.
 * Logo em src/assets/LOGO.png; os links apontam para os ids das seções da página.
 */
import { Image } from 'astro:assets'
import logo from '../assets/LOGO.png'
import Icon from './Icon.astro'
import { site } from '../data/site'
import { hero } from '../data/content'

const solutions = [
  { label: 'Peças e componentes', href: '#vitrine' },
  { label: 'Identificação de peças', href: '#identificar' },
  { label: 'Marcas atendidas', href: '#aplicacoes' },
]

const links = [
  { label: 'Peças', href: '#vitrine' },
  { label: 'Manutenção', href: '#identificar' },
  { label: `Sobre a ${site.brandShort}`, href: '#diferenciais' },
]
---

<header
  data-header
  class="fixed inset-x-0 top-0 z-50 border-b border-white/[0.06] bg-[rgb(0_27_45/0.78)] transition-[background-color,box-shadow] duration-300 data-scrolled:bg-primary-dark-900/95 data-scrolled:shadow-[0_12px_30px_-18px_rgba(0,0,0,0.8)] data-scrolled:backdrop-blur-md"
>
  <div class="mx-auto flex h-(--header-h) max-w-page items-center justify-between gap-6 px-4 sm:px-6 lg:px-10">
    {/* 1. Logo */}
    <a href="/" class="flex shrink-0 items-center">
      <Image
        src={logo}
        alt={site.brand}
        width={276}
        height={92}
        format="webp"
        loading="eager"
        decoding="async"
        class="h-9 w-auto lg:h-[46px]"
      />
    </a>

    {/* 2. Menu (some no mobile) */}
    <nav aria-label="Principal" class="mr-auto ml-11 hidden lg:block">
      <ul class="flex items-center gap-10 font-sans text-[15px] font-medium text-neutral-light">
        <li class="group relative">
          <a
            href="#vitrine"
            class="flex items-center gap-2 py-2 transition-colors hover:text-brand-green"
            aria-haspopup="true"
          >
            Soluções
            <Icon
              name="chevron-down"
              class="size-4 transition-transform group-focus-within:rotate-180 group-hover:rotate-180"
            />
          </a>
          <ul class="invisible absolute top-full left-0 min-w-56 translate-y-1 rounded-lg border border-white/10 bg-primary-dark-900/95 p-2 opacity-0 shadow-[0_18px_40px_-16px_rgba(0,0,0,0.7)] backdrop-blur-md transition-all group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">
            {solutions.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="block rounded-md px-3 py-2 text-sm whitespace-nowrap transition-colors hover:bg-white/5 hover:text-brand-green"
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </li>
        {links.map((item) => (
          <li>
            <a href={item.href} class="py-2 transition-colors hover:text-brand-green">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    {/* 3. CTA com contorno verde-água e o logo do WhatsApp */}
    <button
      type="button"
      data-cta="header-cta"
      class="btn-slave-whats inline-flex shrink-0 items-center gap-2 rounded-xl border-2 border-brand-teal bg-[rgb(1_10_19/0.85)] px-3.5 py-1.5 font-sans text-[13px] font-semibold text-neutral-light transition-colors duration-200 hover:bg-brand-teal/10 sm:px-[18px] sm:py-[7px] sm:text-[15px]"
    >
      <svg class="size-[22px] shrink-0" viewBox="0 0 24 24" aria-hidden="true">
        <path
          fill="#25D366"
          d="M20.464 3.488A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"
        ></path>
        <path
          fill="#fff"
          d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"
        ></path>
      </svg>
      <span class="sm:hidden">Especialista</span>
      <span class="hidden sm:inline">{hero.ctaSecondary}</span>
    </button>
  </div>
</header>

<script>
  // Escurece o header assim que a página sai do topo (sobre o hero ele fica translúcido).
  const header = document.querySelector<HTMLElement>('[data-header]')
  const update = () => header?.toggleAttribute('data-scrolled', window.scrollY > 8)
  update()
  window.addEventListener('scroll', update, { passive: true })
</script>
