---
/**
 * Galeria de aplicações — fase "prova" da biblioteca B2.
 *
 * Cabeçalho centrado e 4 cards-botão com foto 4:3. O card inteiro é o CTA, por
 * isso o `<button>` envolve a foto e o texto.
 */
import { Image } from 'astro:assets'
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import SectionHeader from '@components/SectionHeader.astro'
import type { SectionProps } from '@lib/layout'
import { applications } from '@data/sections/aplicacoes'

type Props = SectionProps

const { tone, rhythm } = Astro.props
---

<Section id="aplicacoes" tone={tone} rhythm={rhythm}>
  <SectionHeader
    eyebrow={applications.eyebrow}
    title={applications.title}
    text={applications.text}
    align="center"
    width="4xl"
  />

  <ul class="mt-9 grid gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:gap-5">
    {applications.items.map((app, i) => (
      <li>
        <button
          type="button"
          data-cta={`aplicacoes-${app.id}`}
          class="btn-slave-whats app-card group relative flex h-full w-full flex-col overflow-hidden rounded-2xl border border-neutral-gray-200/70 bg-neutral-light text-left shadow-[0_1px_2px_rgba(13,29,48,0.05)] transition-[transform,box-shadow,border-color] duration-300 ease-out hover:-translate-y-1.5 hover:border-accent-orange/50 hover:shadow-[0_28px_56px_-28px_rgba(0,33,71,0.35)]"
        >
          <span
            aria-hidden="true"
            class="absolute inset-x-0 top-0 z-10 h-[3px] origin-left scale-x-0 bg-accent-orange transition-transform duration-300 ease-out group-hover:scale-x-100"
          />

          <div class="relative aspect-[4/3] overflow-hidden bg-neutral-gray-100">
            <Image
              src={app.photo.src}
              alt={app.photo.alt}
              format="webp"
              width={640}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover object-center transition-transform duration-500 ease-out group-hover:scale-[1.06]"
            />
            <span
              aria-hidden="true"
              class="pointer-events-none absolute inset-x-0 bottom-0 h-14 bg-gradient-to-t from-primary-dark-900/55 to-transparent"
            />
            <span class="absolute bottom-3 left-4 z-[2] font-display text-[11px] font-extrabold tracking-[0.2em] text-neutral-light/85">
              {String(i + 1).padStart(2, '0')}
            </span>
          </div>

          <div class="flex flex-1 items-start justify-between gap-3 px-5 pt-4 pb-5">
            <span class="flex min-w-0 flex-col gap-1.5">
              <span class="font-display text-lg leading-snug font-extrabold text-ink">
                {app.label}
              </span>
              <span class="font-sans text-[13px] leading-relaxed text-ink-soft">
                {app.description}
              </span>
            </span>
            <span class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-full bg-neutral-gray-100 text-primary-dark transition-[background-color,color,transform] duration-300 group-hover:translate-x-0.5 group-hover:bg-accent-orange group-hover:text-neutral-light">
              <Icon name="arrow-right" class="size-3.5" />
            </span>
          </div>
        </button>
      </li>
    ))}
  </ul>
</Section>

<style>
  @media (prefers-reduced-motion: reduce) {
    .app-card,
    .app-card * {
      transition: none !important;
    }

    .app-card:hover {
      transform: none;
    }
  }
</style>
