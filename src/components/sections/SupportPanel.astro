---
/**
 * Painel de apoio à identificação — fase "apoio" da biblioteca B2.
 *
 * Painel navy dentro de uma seção clara: é uma das duas seções que carregam bloco
 * navy (`carriesNavy`), o respiro escuro da primeira metade da página.
 */
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import Button from '@components/Button.astro'
import Eyebrow from '@components/Eyebrow.astro'
import type { SectionProps } from '@lib/layout'
import { cta } from '@data/content'
import { supportPanel } from '@data/sections/identificar'

type Props = SectionProps

const { tone, rhythm } = Astro.props
---

<Section id="identificar" tone={tone} rhythm={rhythm}>
  <div class="navy-premium tech-corners relative overflow-hidden rounded-2xl border border-white/12 p-6 shadow-[0_14px_32px_-26px_rgba(0,24,48,0.5)] sm:p-8 lg:px-10 lg:py-9">
    <span aria-hidden="true" class="blueprint-grid pointer-events-none absolute inset-0"></span>
    <span
      aria-hidden="true"
      class="pointer-events-none absolute -top-24 -right-20 size-72 rounded-full bg-accent-orange/15 blur-3xl"
    ></span>

    <div class="relative">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between lg:gap-12">
        <div class="max-w-2xl">
          <Eyebrow tone="light">{supportPanel.eyebrow}</Eyebrow>
          <h2 class="mt-3 font-display text-3xl leading-tight font-extrabold text-neutral-light sm:text-4xl">
            {supportPanel.title}
          </h2>
          <p class="mt-3 font-sans text-[15px] leading-relaxed text-neutral-light/70">
            {supportPanel.text}
          </p>
        </div>

        <div class="flex flex-col items-stretch gap-2.5 lg:shrink-0 lg:items-end">
          <Button
            cta="identificar-cta"
            variant="primary"
            class="w-full shadow-[0_14px_30px_-12px_rgba(255,107,0,0.85)] lg:w-auto"
          >
            {cta.secondary}
          </Button>
          <span class="flex items-center justify-center gap-2 font-sans text-xs text-neutral-light/60 lg:justify-end">
            <Icon name="shield" class="size-3.5 shrink-0 text-accent-orange" />
            {supportPanel.microcopy}
          </span>
        </div>
      </div>

      <ul class="support-strip mt-7 grid grid-cols-2 overflow-hidden rounded-xl border border-white/12 sm:grid-cols-3 lg:grid-cols-6">
        {supportPanel.items.map((item) => (
          <li class="support-item flex items-center gap-3 px-4 py-3.5 sm:px-5 lg:gap-2.5 lg:px-3.5">
            <span class="support-badge glass-badge relative flex size-11 shrink-0 items-center justify-center rounded-full text-neutral-light">
              <Icon name={item.icon} class="size-[18px]" />
            </span>
            <span class="flex min-w-0 flex-col gap-0.5">
              <span class="font-sans text-[13px] leading-none font-bold text-neutral-light">
                {item.label}
              </span>
              <span class="font-sans text-[11px] leading-snug text-neutral-light/55">
                {item.hint}
              </span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Section>

<style>
  .support-strip {
    background-color: rgb(255 255 255 / 0.04);
  }

  .support-item {
    border-right: 1px solid rgb(255 255 255 / 0.1);
    border-bottom: 1px solid rgb(255 255 255 / 0.1);
    transition: background-color 260ms ease;
  }

  .support-item:hover {
    background-color: rgb(255 255 255 / 0.05);
  }

  /* Remove a divisória da última coluna / última linha em cada breakpoint */
  .support-item:nth-child(2n) {
    border-right: 0;
  }

  .support-item:nth-last-child(-n + 2) {
    border-bottom: 0;
  }

  @media (width >= 40rem) {
    .support-item:nth-child(2n) {
      border-right: 1px solid rgb(255 255 255 / 0.1);
    }

    .support-item:nth-child(3n) {
      border-right: 0;
    }

    .support-item:nth-last-child(-n + 3) {
      border-bottom: 0;
    }
  }

  @media (width >= 64rem) {
    .support-item {
      border-bottom: 0;
    }

    .support-item:nth-child(3n) {
      border-right: 1px solid rgb(255 255 255 / 0.1);
    }

    .support-item:last-child {
      border-right: 0;
    }
  }

  .support-badge {
    transition:
      transform 260ms ease,
      border-color 260ms ease,
      box-shadow 260ms ease;
  }

  /* Anel laranja que surge no hover */
  .support-badge::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 9999px;
    border: 1px solid rgb(255 107 0 / 0.55);
    opacity: 0;
    transform: scale(0.88);
    transition:
      opacity 260ms ease,
      transform 260ms ease;
    pointer-events: none;
  }

  .support-item:hover .support-badge {
    transform: translateY(-2px);
    border-color: rgb(255 107 0 / 0.6);
  }

  .support-item:hover .support-badge::after {
    opacity: 1;
    transform: scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .support-item,
    .support-badge,
    .support-badge::after {
      transition: none;
    }

    .support-item:hover .support-badge {
      transform: none;
    }
  }
</style>
